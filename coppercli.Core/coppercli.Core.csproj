<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>coppercli.Core</RootNamespace>
    <AssemblyName>coppercli.Core</AssemblyName>
    <NoWarn>$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals to the test project, so safety decisions that are not part of
         Machine's public surface can still be pinned. -->
    <InternalsVisibleTo Include="coppercli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.csv" />
  </ItemGroup>

</Project>
